# OpenRouter powers the AI. Get a key at https://openrouter.ai/keys (free credits on signup).
OPENROUTER_API_KEY=
# Optional: override the model (defaults to deepseek/deepseek-v4-flash-0731).
OPENROUTER_MODEL=

# Your public URL once deployed (used as the API referrer to OpenRouter).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe payments (free to set up). Needed for paid plans.
STRIPE_SECRET_KEY=
# Price ID from Stripe Dashboard -> Products -> your subscription price (starts with price_).
STRIPE_PRICE_PRO_MONTHLY=
# Optional: Business plan price ID ($29/month).
STRIPE_PRICE_BUSINESS_MONTHLY=
# From `stripe listen --forward-to localhost:3000/api/webhook` or Dashboard webhooks.
STRIPE_WEBHOOK_SECRET=
